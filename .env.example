# ResideFix — optional settings for `docker compose up`
#
# You do NOT need this file to start the app: every value below has a safe default.
# To change something, copy it to ".env" (git-ignored) and edit:
#   Copy-Item .env.example .env
#
# Never commit .env. Never put real secrets in .env.example.

# Port on the lab PC where the website is published (http://<lab-pc-ip>:8080).
RESIDEFIX_PORT=8080

# Secret used to sign login tokens (at least 32 characters).
# Leave EMPTY to let the backend generate a strong random secret on first start
# and keep it in the "backend_secrets" Docker volume (recommended for the lab).
JWT_SECRET=

# How long a login stays valid, e.g. 7d or 12h.
JWT_EXPIRES_IN=7d

# Max login/signup attempts per IP address per 15 minutes.
# In a lab many students may share one IP behind a proxy; raise it if needed.
AUTH_RATE_LIMIT=20
