# Backend settings for LOCAL DEVELOPMENT (npm run dev).
# Copy to backend/.env — that file is git-ignored. Docker does NOT use this file;
# it uses the root compose.yaml (and the optional root .env).

# MongoDB running on your own computer, e.g. from: docker compose -f compose.dev.yaml up -d mongo
MONGO_URI=mongodb://localhost:27017/residefix

PORT=5000

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login stays valid (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Only needed if a browser calls the API from a different origin
# (not needed for the Vite dev server, which proxies /api).
CORS_ORIGINS=
